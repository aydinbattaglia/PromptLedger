{
  "manifest_version": 3,
  "name": "PromptLedger",
  "version": "0.1.3",
  "description": "Per-prompt cost and usage tracking for AI creative tools",
  "permissions": [
    "storage",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "*://*.runwayml.com/*",
    "*://*.midjourney.com/*",
    "*://elevenlabs.io/*",
    "*://*.elevenlabs.io/*",
    "https://api.frankfurter.app/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.runwayml.com/*",
        "*://*.midjourney.com/*",
        "*://elevenlabs.io/*",
        "*://*.elevenlabs.io/*"
      ],
      "js": ["inject/network-interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.runwayml.com/*",
        "*://*.midjourney.com/*",
        "*://elevenlabs.io/*",
        "*://*.elevenlabs.io/*"
      ],
      "js": ["content/index.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.runwayml.com/*settings/billing*",
        "*://elevenlabs.io/app/subscription*",
        "*://*.elevenlabs.io/app/subscription*",
        "*://*.midjourney.com/account*"
      ],
      "js": ["plans/detector.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}
